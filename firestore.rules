rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && isOwner(userId);

      // Allow users to update their own profile (but not change role),
      // and allow admins to update any user (including role changes).
      allow update: if (
        // Owner may update their profile but cannot escalate role
        (isOwner(userId) && !('role' in request.resource.data))
        // Admins may update any user, including role changes
        || isAdmin()
      );

      // Allow owners or admins to delete user documents
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Quizzes - readable by all, writable by admins
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Subjects - readable by signed-in users, writable only by admins
    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Attempts - user sees only their own, admins see all
    match /attempts/{attemptId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if signedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable
    }

    // Resources - readable by all, writable by admins
    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Settings (e.g., examCountdown) - readable by signed-in users, writable only by admins
    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Announcements - readable by all, writable by admins
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}