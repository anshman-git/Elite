rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && isOwner(userId);

      // Allow users to update only safe fields on their own profile.
      // The rule checks the changed fields rather than the full document shape.
      allow update: if (
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'points',
            'weeklyPoints',
            'quizzesAttempted',
            'averageScore',
            'streak',
            'lastActiveAt',
            'lastAttemptDate'
          ])
        )
        // Admins may update any field
        || isAdmin()
      );

      // Allow owners or admins to delete user documents
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Quizzes - readable by all, writable by admins
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Subjects - readable by signed-in users, writable only by admins
    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Attempts - pending until stats sync, then completed; rollback deletes pending only
    match /attempts/{attemptId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt'
        ]);

      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending';

      allow delete: if isAdmin();
    }

    // Resources - readable by all, writable by admins
    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Settings (e.g., examCountdown) - readable by signed-in users, writable only by admins
    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Announcements - readable by all, writable by admins
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}