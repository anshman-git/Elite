      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n.ledger-icon { font-size: 17px; line-height: 1; }\n.ledger-icon-sm { font-size: 15px; line-height: 1; }\n.ledger-tabular { font-variant-numeric: tabular-nums; }\n.ledger-section { scroll-margin-top: 24px; }\n.ledger-mobile-only { display: none; }\n.ledger-desktop-only { display: block; }\n.ledger-rail { width: 72px; }\n.ledger-attempt-row { grid-template-columns: 112px minmax(0, 1fr) 150px 92px 70px; }\n.ledger-subject-row { grid-template-columns: minmax(0, 1fr) 70px 86px minmax(120px, 1.1fr) 58px; }\n.ledger-summary-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n.ledger-profile-grid { grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr); }\n.ledger-heatmap { grid-template-columns: repeat(13, minmax(0, 1fr)); }\n.ledger-chart-grid { grid-template-columns: repeat(7, minmax(0, 1fr)); }\n.ledger-chart-bar { min-height: 3px; }\n\n@media (max-width: 720px) {\n  .ledger-desktop-only { display: none !important; }\n  .ledger-mobile-only { display: flex !important; }\n  .ledger-rail { display: none !important; }\n  .ledger-topbar { height: 60px !important; padding-left: 16px !important; padding-right: 16px !important; }\n  .ledger-main { padding-left: 16px !important; padding-right: 16px !important; }\n  .ledger-section { padding-top: 26px !important; padding-bottom: 30px !important; }\n  .ledger-section-title { font-size: 24px !important; }\n  .ledger-action-grid { grid-template-columns: minmax(0, 1fr) !important; }\n  .ledger-profile-grid { grid-template-columns: minmax(0, 1fr) !important; }\n  .ledger-summary-grid { grid-template-columns: minmax(0, 1fr) !important; }\n  .ledger-subject-row { grid-template-columns: minmax(0, 1fr) auto !important; row-gap: 9px; }\n  .ledger-subject-row .ledger-meter { grid-column: 1 / -1; }\n  .ledger-subject-row .ledger-attempts { grid-column: 1; }\n  .ledger-subject-row .ledger-standing { grid-column: 2; text-align: right; }\n  .ledger-attempt-row { grid-template-columns: minmax(0, 1fr) auto !important; row-gap: 5px; }\n  .ledger-attempt-row .ledger-attempt-meta { grid-column: 1; }\n  .ledger-attempt-row .ledger-attempt-action { grid-column: 2; grid-row: 1 / span 2; align-self: center; }\n  .ledger-attempt-row .ledger-attempt-score { grid-column: 1; }\n  .ledger-chart-grid { gap: 8px !important; }\n  .ledger-heatmap { grid-template-columns: repeat(13, minmax(14px, 1fr)); min-width: 290px; }\n  .ledger-heatmap-wrap { overflow-x: auto; }\n}\n</style>\n<div class=\"min-h-[3900px] bg-[#101114] text-[#A5A8AD]\" data-kid=\"1\" style=\"font-family: Manrope, ui-sans-serif, system-ui, sans-serif;\">\n    <header class=\"ledger-topbar flex h-[68px] items-center justify-between border-b border-[#2B2E34] bg-[#101114] px-6\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\">\n            <div class=\"grid h-8 w-8 place-items-center rounded-[8px] border border-[#B98638] text-[#B98638]\" data-kid=\"1-1-1-1\">\n                <i aria-hidden=\"true\" class=\"ti ti-book-2 ledger-icon-sm\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </div>\n            <div class=\"leading-none\" data-kid=\"1-1-1-2\">\n                <p class=\"text-[15px] font-extrabold tracking-[-0.03em] text-[#F2F1EC]\" data-kid=\"1-1-1-2-1\">\n                    Elite\n                    <span class=\"text-[#B98638]\" data-kid=\"1-1-1-2-1-1\">\n                        Study\n                    </span>\n                </p>\n                <p class=\"mt-1 text-[9px] font-semibold uppercase tracking-[0.18em] text-[#737780]\" data-kid=\"1-1-1-2-2\">\n                    Study space\n                </p>\n            </div>\n        </div>\n        <div class=\"ledger-desktop-only flex items-center gap-5\" data-kid=\"1-1-2\">\n            <span class=\"text-xs text-[#737780]\" data-dynamic=\"true\" data-kid=\"1-1-2-1\" data-name=\"date and day display\" data-reason=\"text content updated by script to match the current date\">\n                Tuesday, 27 August 2026\n            </span>\n            <span class=\"h-4 w-px bg-[#2B2E34]\" data-kid=\"1-1-2-2\">\n            </span>\n            <div class=\"flex items-center gap-2 text-xs font-semibold text-[#A5A8AD]\" data-kid=\"1-1-2-3\">\n                <span class=\"grid h-7 w-7 place-items-center rounded-full border border-[#2B2E34] bg-[#17191D] text-[11px] font-bold text-[#F2F1EC]\" data-kid=\"1-1-2-3-1\">\n                    A\n                </span>\n                Anshman\n            </div>\n        </div>\n        <div class=\"ledger-mobile-only items-center gap-3\" data-kid=\"1-1-3\">\n            <span class=\"text-[11px] font-medium text-[#737780]\" data-kid=\"1-1-3-1\">\n                31 attempts\n            </span>\n            <span class=\"grid h-8 w-8 place-items-center rounded-full border border-[#2B2E34] text-[#A5A8AD]\" data-kid=\"1-1-3-2\">\n                <i aria-hidden=\"true\" class=\"ti ti-dots-vertical ledger-icon-sm\" data-kid=\"1-1-3-2-1\">\n                </i>\n            </span>\n        </div>\n    </header>\n    <div class=\"flex items-stretch\" data-kid=\"1-2\">\n        <aside class=\"ledger-rail ledger-desktop-only shrink-0 border-r border-[#2B2E34] bg-[#131519] px-3 py-5\" data-kid=\"1-2-1\">\n            <div class=\"flex min-h-[3650px] flex-col items-center\" data-kid=\"1-2-1-1\">\n                <div class=\"mb-9 grid h-9 w-9 place-items-center rounded-[8px] border border-[#2B2E34] text-[#B98638]\" data-kid=\"1-2-1-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-book-2 ledger-icon-sm\" data-kid=\"1-2-1-1-1-1\">\n                    </i>\n                </div>\n                <nav aria-label=\"Primary navigation\" class=\"flex flex-col items-center gap-5\"